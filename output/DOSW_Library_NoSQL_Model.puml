@startuml

skinparam classAttributeIconSize 0
hide circle

' =====================
' CLASES RELACIONALES
' =====================

class User {
  - userId: Long
  - name: String
  - email: String
  - passwordHash: String
  - membershipType: MembershipType
  - roles: List<String>
  - accountStatus: AccountStatus
  - failedAttempts: int
  - lastLoginAt: LocalDateTime
  - addedToLibrary: LocalDateTime
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
}

class Book {
  - bookId: Long
  - title: String
  - author: String
  - isbn: String
  - publicationType: PublicationType
  - publicationDate: LocalDate
  - categories: List<String>
  - metadataPages: int
  - metadataLanguage: String
  - metadataPublisherCompany: String
  - totalCopies: int
  - availableCopies: int
  - loanedCopies: int
  - addedToCatalogAt: LocalDateTime
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
}

class Loan {
  - loanId: Long
  - userId: Long
  - bookId: Long
  - loanDate: LocalDateTime
  - returnDate: LocalDateTime
  - currentStatus: LoanStatus
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
}

class LoanHistory {
  - historyId: Long
  - loanId: Long
  - status: LoanStatus
  - executedAt: LocalDateTime
}

enum MembershipType {
  STANDARD
  PLATINUM
  VIP
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PublicationType {
  MAGAZINE
  EBOOK
  CARTILLA
  OTHER
}

enum LoanStatus {
  CREATED
  ACTIVE
  RETURNED
  OVERDUE
}

' =====================
' RELACIONES
' =====================

User --> Loan
Book --> Loan
Loan --> LoanHistory

' =====================
' REPRESENTACION NoSQL
' =====================

class UserDoc <<NoSQL Document>> {
  _id: ObjectId
  --
  name: String
  email: String
  membershipType: String
  addedToLibrary: Date
  createdAt: Date
  updatedAt: Date
  --
  EMBEBIDO: auth {
    - passwordHash: String
    - roles: List<String>
    - accountStatus: String
    - failedAttempts: int
    - lastLoginAt: Date
  }
}

class BookDoc <<NoSQL Document>> {
  _id: ObjectId
  --
  title: String
  author: String
  isbn: String
  publicationType: String
  publicationDate: Date
  categories: List<String>
  addedToCatalogAt: Date
  createdAt: Date
  updatedAt: Date
  --
  EMBEBIDO: metadata {
    - pages: int
    - language: String
    - publisherCompany: String
  }
  EMBEBIDO: availability {
    - status: String
    - totalCopies: int
    - availableCopies: int
    - loanedCopies: int
  }
}

class LoanDoc <<NoSQL Document>> {
  _id: ObjectId
  --
  userRef: ObjectId
  bookRef: ObjectId
  loanDate: Date
  returnDate: Date
  currentStatus: String
  createdAt: Date
  updatedAt: Date
  --
  EMBEBIDO: history {
    - List<LoanHistoryItem>
  }
}

class LoanHistoryItem <<NoSQL Embedded>> {
  status: String
  executedAt: Date
}

' =====================
' RELACIONES Y MAPEO
' =====================

User ..> UserDoc
Book ..> BookDoc
Loan ..> LoanDoc
LoanHistory ..> LoanHistoryItem

LoanDoc --> UserDoc : userRef (REFERENCIADO)
LoanDoc --> BookDoc : bookRef (REFERENCIADO)
LoanDoc *-- LoanHistoryItem : EMBEBIDO

' =====================
' NOTAS EXPLICATIVAS
' =====================

note right of UserDoc
EMBEBIDO (auth):
Los datos de autenticación 
viven siempre con el usuario.
Se consultan juntos.
Sin joins necesarios.
end note

note right of BookDoc
EMBEBIDO (metadata, availability):
Metadata y disponibilidad
pertenecen semánticamente al libro.
Consultas frecuentes sin joins.
Actualización atómica.
end note

note bottom of LoanDoc
EMBEBIDO (history):
El historial de estados
pertenece al préstamo.
Captura la línea de tiempo completa.

REFERENCIADO (userRef, bookRef):
Solo IDs para evitar duplicación.
Datos del usuario/libro cambian
sin afectar archivos de préstamos.
end note

@enduml
